; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Vault"
config/description="A sandbox for Godot experimentation, reusable components, and best practices"
config/version="0.1.0"
run/main_scene="res://examples/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/autoload/event_bus.gd"
GameManager="*res://core/autoload/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
